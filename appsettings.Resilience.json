{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "Default": {
      "TimeoutSeconds": 30,
      "MaxRetries": 3,
      "FailureThreshold": 5,
      "CircuitBreakerTimeoutSeconds": 30,
      "SuccessThreshold": 2,
      "InitialDelayMilliseconds": 100,
      "BackoffMultiplier": 2.0,
      "MaxJitterMilliseconds": 100,
      "MaxParallelization": 10,
      "MaxQueued": 50
    },
    "YourApiClient": {
      "TimeoutSeconds": 30,
      "MaxRetries": 3,
      "FailureThreshold": 5,
      "CircuitBreakerTimeoutSeconds": 30,
      "SuccessThreshold": 2,
      "InitialDelayMilliseconds": 100,
      "BackoffMultiplier": 2.0,
      "MaxJitterMilliseconds": 100,
      "MaxParallelization": 10,
      "MaxQueued": 50
    },
    "YourCriticalClient": {
      "TimeoutSeconds": 20,
      "MaxRetries": 5,
      "FailureThreshold": 3,
      "CircuitBreakerTimeoutSeconds": 20,
      "SuccessThreshold": 2,
      "InitialDelayMilliseconds": 50,
      "BackoffMultiplier": 1.5,
      "MaxJitterMilliseconds": 50,
      "MaxParallelization": 20,
      "MaxQueued": 100
    },
    "YourFallibleClient": {
      "TimeoutSeconds": 10,
      "MaxRetries": 1,
      "FailureThreshold": 2,
      "CircuitBreakerTimeoutSeconds": 60,
      "SuccessThreshold": 3,
      "InitialDelayMilliseconds": 100,
      "BackoffMultiplier": 1.0,
      "MaxJitterMilliseconds": 50,
      "MaxParallelization": 5,
      "MaxQueued": 20
    }
  }
}
