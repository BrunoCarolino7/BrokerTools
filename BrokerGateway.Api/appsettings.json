{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "Default": {
      "TimeoutSeconds": 30,
      "MaxRetries": 3,
      "FailureThreshold": 5,
      "CircuitBreakerTimeoutSeconds": 30,
      "SuccessThreshold": 2,
      "InitialDelayMilliseconds": 100,
      "BackoffMultiplier": 2.0,
      "MaxJitterMilliseconds": 100,
      "MaxParallelization": 10,
      "MaxQueued": 50
    },
    "HttpBin": {
      "TimeoutSeconds": 30,
      "MaxRetries": 10,
      "FailureThreshold": 5,
      "CircuitBreakerTimeoutSeconds": 30,
      "SuccessThreshold": 2,
      "InitialDelayMilliseconds": 100,
      "BackoffMultiplier": 2.0,
      "MaxJitterMilliseconds": 100,
      "MaxParallelization": 10,
      "MaxQueued": 50
    }
  }
}

